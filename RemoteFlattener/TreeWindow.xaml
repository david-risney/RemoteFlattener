<Window x:Class="RemoteFlattener.TreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteFlattener – Desktop Map"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        PreviewKeyDown="Window_KeyDown"
        Focusable="True">
    <Border x:Name="ContentPanel"
            MinWidth="500" MaxWidth="740" MaxHeight="900"
            Background="#F01E1E2E"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="48" Opacity="0.75" Color="Black"/>
        </Border.Effect>
        <DockPanel>

                <!-- ── Header ── -->
                <Border DockPanel.Dock="Top" Background="#11111C" Padding="20,14,12,14">
                    <DockPanel LastChildFill="False">
                        <!-- Settings icon button -->
                        <Button x:Name="SettingsButton"
                                DockPanel.Dock="Right"
                                Content="⚙"
                                FontFamily="Segoe UI Emoji, Segoe UI"
                                FontSize="15"
                                Foreground="#55556A"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="7,5"
                                Cursor="Hand"
                                VerticalAlignment="Top"
                                ToolTip="Settings"
                                Click="SettingsButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1EFFFFFF"/>
                                            <Setter Property="Foreground" Value="#9999B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Title + keyboard hint -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Desktop Map"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Border Background="#1EFFFFFF" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                                    <TextBlock Text="↑↓" Foreground="#7777AA" FontSize="9" FontFamily="Segoe UI"/>
                                </Border>
                                <TextBlock Text="Navigate" Foreground="#33334A" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Background="#1EFFFFFF" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                                    <TextBlock Text="↵" Foreground="#7777AA" FontSize="9" FontFamily="Segoe UI"/>
                                </Border>
                                <TextBlock Text="Activate" Foreground="#33334A" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Background="#1EFFFFFF" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                                    <TextBlock Text="Esc" Foreground="#7777AA" FontSize="9" FontFamily="Segoe UI"/>
                                </Border>
                                <TextBlock Text="Close" Foreground="#33334A" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 1 px rule -->
                <Rectangle DockPanel.Dock="Top" Height="1" Fill="#18FFFFFF"/>

                <!-- ── Scrollable tree ── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,10">
                    <TreeView x:Name="NetworkTree"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="White"
                              Focusable="False"
                              KeyboardNavigation.DirectionalNavigation="None"
                              KeyboardNavigation.TabNavigation="None"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <TreeView.Template>
                            <!-- Strip the TreeView's built-in ScrollViewer so mouse-wheel
                                 events bubble up to the outer ScrollViewer. -->
                            <ControlTemplate TargetType="TreeView">
                                <ItemsPresenter/>
                            </ControlTemplate>
                        </TreeView.Template>
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground"                 Value="White"/>
                                <Setter Property="FontFamily"                 Value="Segoe UI"/>
                                <Setter Property="FontSize"                   Value="13"/>
                                <Setter Property="IsExpanded"                 Value="True"/>
                                <Setter Property="Background"                 Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding"                    Value="4,0"/>
                                <Setter Property="Focusable"                  Value="False"/>
                                <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </ScrollViewer>

            </DockPanel>
        </Border>
</Window>
