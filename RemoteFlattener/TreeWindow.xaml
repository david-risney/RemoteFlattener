<Window x:Class="RemoteFlattener.TreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteFlattener – Network Tree"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#AA000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown"
        Focusable="True">
    <Grid>
        <!-- Semi-transparent full-screen backdrop; clicking it closes the window. -->
        <Rectangle Fill="Transparent"/>

        <Border Background="#EE1E1E2E"
                CornerRadius="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="380"
                MaxWidth="600"
                Padding="24,20">
            <StackPanel>
                <TextBlock Text="Network Tree"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <TreeView x:Name="NetworkTree"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          IsHitTestVisible="False">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize"   Value="13"/>
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </TreeView.Resources>
                </TreeView>

                <TextBlock Text="Click anywhere or press Escape to close"
                           Foreground="#888888"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
