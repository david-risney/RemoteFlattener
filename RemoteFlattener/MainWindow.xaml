<Window x:Class="RemoteFlattener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteFlattener" Height="540" Width="420"
        ResizeMode="CanResize" MinWidth="320" MinHeight="400">
    <StackPanel Margin="12" VerticalAlignment="Top">

        <!-- Password section -->
        <Label Content="Password:" FontWeight="Bold" Padding="0,0,0,2"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Generate" Width="80" Margin="6,0,0,0"
                    Click="GeneratePassword_Click"/>
            <TextBox x:Name="PasswordBox"/>
        </DockPanel>

        <!-- Machine list section -->
        <Label Content="Machines (one per line):" FontWeight="Bold"
               Margin="0,10,0,2" Padding="0,0,0,2"/>
        <TextBox x:Name="MachinesBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="90" VerticalScrollBarVisibility="Auto"/>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="StartButton" Content="Start" Width="80"
                    Margin="0,0,10,0" Click="Start_Click"/>
            <Button x:Name="StopButton" Content="Stop" Width="80"
                    IsEnabled="False" Click="Stop_Click"/>
        </StackPanel>

        <!-- Status -->
        <Label Content="Status:" FontWeight="Bold" Margin="0,10,0,2" Padding="0,0,0,2"/>
        <Border Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="6,4">
            <Label x:Name="StatusLabel" Content="Stopped" Padding="0"/>
        </Border>

        <!-- Connected machines -->
        <Label Content="Connected Machines:" FontWeight="Bold"
               Margin="0,10,0,2" Padding="0,0,0,2"/>
        <ListBox x:Name="ConnectionList" Height="160"
                 ItemsSource="{Binding Connections}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="12"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </StackPanel>
</Window>
