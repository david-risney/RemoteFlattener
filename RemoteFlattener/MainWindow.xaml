<Window x:Class="RemoteFlattener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteFlattener" Width="460"
        Icon="pack://application:,,,/Assets/app.ico"
        SizeToContent="Height" MaxHeight="780"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Dark card panel -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"    Value="#2A2A3C"/>
            <Setter Property="CornerRadius"  Value="8"/>
            <Setter Property="Padding"       Value="16,12"/>
            <Setter Property="Margin"        Value="0,0,0,10"/>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#888899"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
            <Setter Property="Text"        Value="SECTION"/>
        </Style>

        <!-- Dark ComboBox -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background"      Value="#13131F"/>
            <Setter Property="Foreground"      Value="#E0E0F0"/>
            <Setter Property="BorderBrush"     Value="#3A3A50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="▾" Foreground="#666680" FontSize="11"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#5A5A70"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDown"
                                        Background="#1E1E2E"
                                        BorderBrush="#3A3A50"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="2">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground"  Value="#E0E0F0"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Padding"     Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33335A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark text box -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"         Value="#13131F"/>
            <Setter Property="Foreground"         Value="#E0E0F0"/>
            <Setter Property="BorderBrush"        Value="#3A3A50"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Padding"            Value="8,6"/>
            <Setter Property="FontFamily"         Value="Consolas"/>
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="CaretBrush"         Value="#A0A0FF"/>
            <Setter Property="SelectionBrush"     Value="#3050A0"/>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"         Value="#4A6FA5"/>
            <Setter Property="Foreground"         Value="White"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="Padding"            Value="18,7"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A82BE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#385D8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A3C"/>
                                <Setter Property="Foreground" Value="#555566"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (Stop) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#7A3040"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9A3F52"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#5A2030"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A3C"/>
                    <Setter Property="Foreground" Value="#555566"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#33334A"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44445A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222230"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A3C"/>
                    <Setter Property="Foreground" Value="#555566"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="10" ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer action bar -->
        </Grid.RowDefinitions>

        <!-- ── Header / Custom Titlebar ── -->
        <Border Grid.Row="0" Background="#16161F" Padding="16,10,8,10"
                CornerRadius="10,10,0,0">
            <DockPanel>
                <!-- Window buttons (in caption area but clickable) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="StatusPill"
                            CornerRadius="12" Padding="10,3" Margin="0,0,6,0"
                            Background="#2A2A38" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusLabel" Text="● Stopped"
                                   Foreground="#666680" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="─" Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" Foreground="#888899"
                            BorderThickness="0" FontSize="14" Width="32" Height="32"
                            Cursor="Hand" FontFamily="Segoe UI"/>
                    <Button Content="✕" Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Background="Transparent" Foreground="#888899"
                            BorderThickness="0" FontSize="12" Width="32" Height="32"
                            Cursor="Hand" FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               WindowChrome.IsHitTestVisibleInChrome="True">
                        <Hyperlink NavigateUri="https://github.com/david-risney/RemoteFlattener"
                                   RequestNavigate="TitleLink_RequestNavigate"
                                   Foreground="White">
                            RemoteFlattener
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="VersionLabel"
                               Foreground="#666680" FontSize="11" VerticalAlignment="Center"
                               Margin="8,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Content ── -->
        <StackPanel Grid.Row="1" Margin="16,12,16,8">

                <!-- Desktop Map card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="NetworkTreeButton"
                                    DockPanel.Dock="Right"
                                    Content="🌐 Desktop Map"
                                    Style="{StaticResource GhostButton}"
                                    IsEnabled="False"
                                    Click="NetworkTree_Click"/>
                            <Button x:Name="NetworkToggle"
                                    Style="{StaticResource GhostButton}"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Padding="0,7"
                                    Click="NetworkToggle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NetworkChevron" Text="▸"
                                               Foreground="#666680" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="NETWORK"
                                               Style="{StaticResource SectionLabel}"
                                               Margin="0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- VPN auto-connect (collapsible) -->
                        <StackPanel x:Name="NetworkSection" Visibility="Collapsed" Margin="0,8,0,0">
                            <DockPanel>
                                <ComboBox x:Name="VpnNameCombo"
                                          DockPanel.Dock="Right"
                                          MinWidth="160" MaxWidth="220"
                                          IsEnabled="False"
                                          Style="{StaticResource DarkComboBox}"
                                          VerticalAlignment="Center"
                                          SelectionChanged="VpnNameCombo_SelectionChanged"
                                          DropDownOpened="VpnNameCombo_DropDownOpened"/>
                                <CheckBox x:Name="AutoConnectVpnCheck"
                                          Content="Auto-connect VPN"
                                          Foreground="#CCCCDD"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Checked="AutoConnectVpnCheck_Changed"
                                          Unchecked="AutoConnectVpnCheck_Changed"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Connection card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- Peers row -->
                        <StackPanel Margin="0,0,0,4">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Detect"
                                        Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        Click="DetectMachines_Click"/>
                                <Button x:Name="PeersToggle"
                                        Style="{StaticResource GhostButton}"
                                        Background="Transparent"
                                        HorizontalAlignment="Left"
                                        HorizontalContentAlignment="Left"
                                        Padding="0,7"
                                        Click="PeersToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PeersChevron" Text="▾"
                                                   Foreground="#666680" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="PEERS"
                                                   Style="{StaticResource SectionLabel}"
                                                   Margin="0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <StackPanel x:Name="PeersSection" Margin="0,6,0,0">

                            <!-- Live peer rows -->
                            <Border Background="#13131F" BorderBrush="#3A3A50"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="4,4,4,4" MinHeight="62" MaxHeight="160">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Connections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,5"
                                                        Margin="0,0,0,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1E1E30"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel LastChildFill="True">
                                                        <!-- Remove button -->
                                                        <Button DockPanel.Dock="Right"
                                                                Content="×"
                                                                Tag="{Binding MachineName}"
                                                                Click="RemovePeer_Click"
                                                                Style="{StaticResource GhostButton}"
                                                                Padding="7,1" FontSize="14"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Remove peer"/>
                                                        <!-- Status dot -->
                                                        <Ellipse Width="7" Height="7"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <!-- offline / not yet seen -->
                                                                    <Setter Property="Fill" Value="#333348"/>
                                                                    <Style.Triggers>
                                                                        <!-- indirect / mesh-only -->
                                                                        <DataTrigger Binding="{Binding IsIndirect}" Value="True">
                                                                            <Setter Property="Fill" Value="#D4853A"/>
                                                                        </DataTrigger>
                                                                        <!-- directly connected (takes priority) -->
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                            <Setter Property="Fill" Value="#5AD06A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <!-- Name + inline status -->
                                                        <WrapPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MachineName}"
                                                                       FontFamily="Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#555570"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIndirect}" Value="True">
                                                                                <Setter Property="Foreground" Value="#D0D0E8"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                <Setter Property="Foreground" Value="#D0D0E8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Parenthetical status label; triggers mirror dot-color priority -->
                                                            <TextBlock FontFamily="Segoe UI"
                                                                       FontSize="10"
                                                                       FontStyle="Italic"
                                                                       Margin="5,1,0,0"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text"       Value="(disconnected)"/>
                                                                        <Setter Property="Foreground" Value="#44445A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIndirect}" Value="True">
                                                                                <Setter Property="Text"       Value="(via mesh)"/>
                                                                                <Setter Property="Foreground" Value="#8A5F28"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                <Setter Property="Text"       Value="(connected)"/>
                                                                                <Setter Property="Foreground" Value="#3A7A44"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </WrapPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Add peer row -->
                            <DockPanel Margin="0,6,0,0"
                                       KeyboardNavigation.TabNavigation="Local">
                                <Button DockPanel.Dock="Right"
                                        Content="+ Add"
                                        Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0"
                                        TabIndex="1"
                                        Click="AddPeer_Click"/>
                                <Grid>
                                    <TextBox x:Name="AddPeerBox"
                                             Style="{StaticResource DarkTextBox}"
                                             TabIndex="0"
                                             KeyDown="AddPeerBox_KeyDown"/>
                                    <!-- Placeholder overlay: visible only when box is empty -->
                                    <TextBlock Text="hostname or IP address"
                                               Foreground="#44445A"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Padding="9,7"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=AddPeerBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                            <TextBlock x:Name="PeersStatusText"
                                       FontSize="10" Foreground="#666680"
                                       Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Password card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="PasswordToggle"
                                    Style="{StaticResource GhostButton}"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Padding="0,7"
                                    Click="PasswordToggle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PasswordChevron" Text="▸"
                                               Foreground="#666680" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="PASSWORD"
                                               Style="{StaticResource SectionLabel}"
                                               Margin="0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <Grid x:Name="PasswordSection" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PasswordBox" Grid.Column="0"
                                     Style="{StaticResource DarkTextBox}"/>
                            <Button Grid.Column="1" Content="↻ Generate"
                                    Style="{StaticResource GhostButton}"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Click="GeneratePassword_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Log card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open File"
                                    Style="{StaticResource GhostButton}"
                                    Click="OpenLog_Click"/>
                            <Button x:Name="LogToggle"
                                    Style="{StaticResource GhostButton}"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Padding="0,2"
                                    Click="LogToggle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LogChevron" Text="▸"
                                               Foreground="#666680" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="LOG"
                                               Style="{StaticResource SectionLabel}"
                                               Margin="0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <TextBox x:Name="LogBox"
                                 Visibility="Collapsed"
                                 Margin="0,8,0,0"
                                 Height="140"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#0D0D18"
                                 Foreground="#8888AA"
                                 BorderBrush="#3A3A50"
                                 BorderThickness="1"
                                 Padding="8,6"/>
                    </StackPanel>
                </Border>

        </StackPanel>

        <!-- ── Footer action bar ── -->
        <Border Grid.Row="2" Background="#16161F" Padding="16,10"
                CornerRadius="0,0,10,10">
            <DockPanel>
                <Button x:Name="StartButton"
                        DockPanel.Dock="Right"
                        Content="▶  Start"
                        Style="{StaticResource PrimaryButton}"
                        Click="Toggle_Click"/>
            </DockPanel>
        </Border>
    </Grid>
    </Border>
</Window>
