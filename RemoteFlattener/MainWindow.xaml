<Window x:Class="RemoteFlattener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RemoteFlattener" Height="660" Width="460"
        ResizeMode="CanResize" MinWidth="360" MinHeight="480"
        Background="#1E1E2E">
    <Window.Resources>
        <!-- Dark card panel -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"    Value="#2A2A3C"/>
            <Setter Property="CornerRadius"  Value="8"/>
            <Setter Property="Padding"       Value="16,12"/>
            <Setter Property="Margin"        Value="0,0,0,10"/>
        </Style>

        <!-- Section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#888899"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
            <Setter Property="Text"        Value="SECTION"/>
        </Style>

        <!-- Dark text box -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"         Value="#13131F"/>
            <Setter Property="Foreground"         Value="#E0E0F0"/>
            <Setter Property="BorderBrush"        Value="#3A3A50"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Padding"            Value="8,6"/>
            <Setter Property="FontFamily"         Value="Consolas"/>
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="CaretBrush"         Value="#A0A0FF"/>
            <Setter Property="SelectionBrush"     Value="#3050A0"/>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"         Value="#4A6FA5"/>
            <Setter Property="Foreground"         Value="White"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="Padding"            Value="18,7"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A82BE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#385D8A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A3C"/>
                                <Setter Property="Foreground" Value="#555566"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (Stop) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#7A3040"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9A3F52"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#5A2030"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A3C"/>
                    <Setter Property="Foreground" Value="#555566"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost button -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#33334A"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44445A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222230"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A3C"/>
                    <Setter Property="Foreground" Value="#555566"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Scrollable content -->
            <RowDefinition Height="Auto"/>  <!-- Footer action bar -->
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="#16161F" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status pill -->
                    <Border x:Name="StatusPill" CornerRadius="12" Padding="10,3" Background="#2A3A2A">
                        <TextBlock x:Name="StatusLabel" Text="● Stopped"
                                   Foreground="#5A9A5A" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RemoteFlattener" Foreground="White"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="RoleLabel" Text="Virtual desktop sync over RDP"
                               Foreground="#666680" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Scrollable body ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,4">
            <StackPanel>

                <!-- Connection card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="CONNECTION"/>
                        <!-- Password row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Shared Password" Foreground="#AAAACC"
                                           FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="PasswordBox" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="↻ Generate"
                                    Style="{StaticResource GhostButton}"
                                    VerticalAlignment="Bottom" Margin="8,0,0,0"
                                    Click="GeneratePassword_Click"/>
                        </Grid>

                        <!-- Peers row -->
                        <StackPanel Margin="0,0,0,4">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="⊕ Detect"
                                        Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        Click="DetectMachines_Click"/>
                                <TextBlock Text="Peers" Foreground="#AAAACC"
                                           FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Live peer rows -->
                            <Border Background="#13131F" BorderBrush="#3A3A50"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="4,4,4,4" MaxHeight="160">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Connections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,5"
                                                        Margin="0,0,0,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1E1E30"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel LastChildFill="True">
                                                        <!-- Remove button -->
                                                        <Button DockPanel.Dock="Right"
                                                                Content="×"
                                                                Tag="{Binding MachineName}"
                                                                Click="RemovePeer_Click"
                                                                Style="{StaticResource GhostButton}"
                                                                Padding="7,1" FontSize="14"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Remove peer"/>
                                                        <!-- Status dot -->
                                                        <Ellipse Width="7" Height="7"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#333348"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                            <Setter Property="Fill" Value="#5AD06A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <!-- Name + status info -->
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MachineName}"
                                                                       FontFamily="Segoe UI"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#555570"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                <Setter Property="Foreground" Value="#D0D0E8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="10"
                                                                       Foreground="#444458"
                                                                       Margin="0,1,0,0"
                                                                       Visibility="Collapsed">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Add peer row -->
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right"
                                        Content="⊕ Add"
                                        Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0"
                                        Click="AddPeer_Click"/>
                                <TextBox x:Name="AddPeerBox"
                                         Style="{StaticResource DarkTextBox}"
                                         KeyDown="AddPeerBox_KeyDown"/>
                            </DockPanel>
                            <TextBlock Text="Type a hostname or IP, then Add — or use Detect"
                                       Foreground="#555566" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Log card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Open File"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="11" Padding="10,4"
                                    Click="OpenLog_Click"/>
                            <TextBlock Style="{StaticResource SectionLabel}"
                                       Text="LOG" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                        <TextBox x:Name="LogBox"
                                 Height="140"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="#0D0D18"
                                 Foreground="#8888AA"
                                 BorderBrush="#3A3A50"
                                 BorderThickness="1"
                                 Padding="8,6"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer action bar ── -->
        <Border Grid.Row="2" Background="#16161F" Padding="16,10">
            <DockPanel>
                <Button x:Name="NetworkTreeButton"
                        DockPanel.Dock="Right"
                        Content="🌐 Network Tree"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False"
                        Padding="14,7"
                        Click="NetworkTree_Click"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton"
                            Content="▶  Start"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="Start_Click"/>
                    <Button x:Name="StopButton"
                            Content="■  Stop"
                            Style="{StaticResource DangerButton}"
                            IsEnabled="False"
                            Click="Stop_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
